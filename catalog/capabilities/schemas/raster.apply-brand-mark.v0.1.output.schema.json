{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openadam:capability:raster.apply-brand-mark:v0.1:output",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "source", "output", "placement"],
  "properties": {
    "status": { "const": "ok" },
    "source": { "$ref": "#/$defs/dimensions" },
    "output": { "$ref": "#/$defs/output" },
    "placement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["anchor", "x", "y", "width", "height", "scale", "margin_x", "margin_y", "opacity", "max_width_ratio"],
      "properties": {
        "anchor": { "enum": ["top-left", "top-center", "top-right", "center-left", "center", "center-right", "bottom-left", "bottom-center", "bottom-right"] },
        "x": { "type": "integer", "minimum": 0 },
        "y": { "type": "integer", "minimum": 0 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "scale": { "type": "number", "exclusiveMinimum": 0 },
        "margin_x": { "type": "integer", "minimum": 0 },
        "margin_y": { "type": "integer", "minimum": 0 },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "max_width_ratio": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
      }
    }
  },
  "$defs": {
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": { "width": { "type": "integer", "minimum": 1 }, "height": { "type": "integer", "minimum": 1 } }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "format", "width", "height", "bytes", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "format": { "const": "png" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}
