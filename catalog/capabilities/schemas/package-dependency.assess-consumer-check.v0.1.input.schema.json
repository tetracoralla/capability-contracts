{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["checkId", "status"],
  "properties": {
    "checkId": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$", "maxLength": 160 },
    "status": { "enum": ["passed", "failed", "unavailable"] }
  }
}

