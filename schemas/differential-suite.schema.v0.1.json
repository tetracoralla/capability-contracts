{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openadam:schema:differential-suite:v0.1",
  "title": "OpenAdam cross-provider differential suite v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "capabilityId", "capabilityVersion", "comparisonPolicy", "cases"],
  "properties": {
    "schemaVersion": { "const": "openadam.differential-suite.v0.1" },
    "capabilityId": { "$ref": "#/$defs/stableId" },
    "capabilityVersion": { "$ref": "#/$defs/semver" },
    "comparisonPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ignoredResultPaths"],
      "properties": {
        "ignoredResultPaths": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["operationId", "pointer", "semanticRole", "basis"],
            "properties": {
              "operationId": { "$ref": "#/$defs/stableId" },
              "pointer": { "$ref": "#/$defs/jsonPointer" },
              "semanticRole": { "enum": ["runtime-context", "provenance"] },
              "basis": { "type": "string", "minLength": 1, "maxLength": 500 }
            }
          }
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
      "maxLength": 160
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
    },
    "jsonPointer": {
      "type": "string",
      "pattern": "^/(?:[^~/]|~[01])+(?:/(?:[^~/]|~[01])*)*$",
      "maxLength": 500
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "operationId", "description", "input", "comparison"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "operationId": { "$ref": "#/$defs/stableId" },
        "description": { "type": "string", "minLength": 1, "maxLength": 500 },
        "input": true,
        "comparison": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "ignorePointers", "ignoredPathBasis"],
          "properties": {
            "kind": { "const": "canonical-exact-except" },
            "ignorePointers": {
              "type": "array",
              "maxItems": 8,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/jsonPointer" }
            },
            "ignoredPathBasis": { "type": "string", "minLength": 1, "maxLength": 500 }
          }
        },
        "timeoutMs": { "type": "integer", "minimum": 10, "maximum": 60000, "default": 10000 }
      }
    }
  }
}
