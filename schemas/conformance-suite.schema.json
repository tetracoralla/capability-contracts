{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openadam:schema:conformance-suite:v0.1",
  "title": "OpenAdam capability conformance suite v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "capabilityId",
    "capabilityVersion",
    "cases"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "openadam.conformance-suite.v0.1" },
    "capabilityId": { "$ref": "#/$defs/stableId" },
    "capabilityVersion": { "$ref": "#/$defs/semver" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
      "maxLength": 160
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
    },
    "expectation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["outcome", "match"],
          "properties": {
            "outcome": { "const": "success" },
            "match": { "enum": ["schema", "subset", "exact"] },
            "value": true
          },
          "allOf": [
            {
              "if": {
                "properties": { "match": { "enum": ["subset", "exact"] } },
                "required": ["match"]
              },
              "then": { "required": ["value"] }
            }
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["outcome", "code"],
          "properties": {
            "outcome": { "const": "error" },
            "code": { "type": "string", "minLength": 1, "maxLength": 100 },
            "messageIncludes": { "type": "string", "minLength": 1, "maxLength": 300 }
          }
        }
      ]
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "operationId", "description", "input", "expect"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "operationId": { "$ref": "#/$defs/stableId" },
        "description": { "type": "string", "minLength": 1, "maxLength": 500 },
        "input": true,
        "expect": { "$ref": "#/$defs/expectation" },
        "timeoutMs": {
          "type": "integer",
          "minimum": 10,
          "maximum": 60000,
          "default": 10000
        }
      }
    }
  }
}
